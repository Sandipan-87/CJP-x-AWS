# Engram — TEMPLATE. This file IS committed (see .gitignore's `!.env.example`).
# Copy to .env and fill in there. NEVER put real values in this file.
# Phase 3 (P3-P4) moves all of these into AWS Secrets Manager.

# ---- LLM provider switch: "bedrock" | "anthropic" ----
ENGRAM_LLM_PROVIDER=bedrock

# ---- AWS / Bedrock (P0-B1) ----
AWS_REGION=us-east-1
# Overrides only if verify_bedrock.py's candidate list does not resolve:
# BEDROCK_CLAUDE_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Anthropic first-party API (alternative to Bedrock for reasoning only) ----
# NOTE: Anthropic has no embeddings API. Titan V2 stays on Bedrock either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-5

# ---- CockroachDB MEMORY cluster (P0-P1) — the product ----
ENGRAM_MEMORY_DSN=postgresql://<user>:<pw>@<host>:26257/defaultdb?sslmode=verify-full
ENGRAM_MEMORY_CLUSTER_ID=<uuid from the cluster page URL>

# ---- CockroachDB TARGET cluster (P0-P2) — the subject ----
ENGRAM_TARGET_DSN=postgresql://<user>:<pw>@<host>:26257/defaultdb?sslmode=verify-full
ENGRAM_TARGET_CLUSTER_ID=<uuid from the cluster page URL>

# ---- Managed MCP server (P0-B2) — scope mcp:read, Cluster Operator ----
# CRDB_MCP_CLUSTER_ID must be the MEMORY cluster UUID (same as ENGRAM_MEMORY_CLUSTER_ID).
CRDB_MCP_URL=https://cockroachlabs.cloud/mcp
CRDB_MCP_TOKEN=
CRDB_MCP_CLUSTER_ID=
CRDB_MCP_DATABASE=defaultdb
CRDB_MCP_PROBE_TABLE=vec_probe
