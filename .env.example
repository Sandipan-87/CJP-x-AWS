# Engram — TEMPLATE. This file IS committed (see .gitignore's `!.env.example`).
# Copy to .env and fill in there. NEVER put real values in this file.
# Phase 3 (P3-P4) moves all of these into AWS Secrets Manager.
#
# Provider pivot 2026-08-11 (CLAUDE.md §2.1, D13): reasoning = Ollama Cloud
# (minimax-m3:cloud), embeddings = Cohere, AWS = S3 only. NO BEDROCK KEYS
# BELONG IN THIS FILE.

# ---- LLM & Embeddings ----
OLLAMA_API_KEY=your_ollama_api_key
COHERE_API_KEY=your_cohere_api_key
EMBEDDING_MODEL=embed-english-v3.0
EMBEDDING_DIM=1024

# ---- AWS S3 Integration ----
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=engram-agent-artifacts

# ---- CockroachDB ----
# DATABASE_URL is the MEMORY cluster (the product). The two-cluster split below
# is authoritative — CLAUDE.md §2: "two clusters, two roles, never conflate."
DATABASE_URL=postgresql://<user>:<pw>@<host>:26257/defaultdb?sslmode=verify-full

# ---- CockroachDB MEMORY cluster (P0-P1) — the product ----
ENGRAM_MEMORY_DSN=postgresql://<user>:<pw>@<host>:26257/defaultdb?sslmode=verify-full
ENGRAM_MEMORY_CLUSTER_ID=<uuid from the cluster page URL>

# ---- CockroachDB TARGET cluster (P0-P2) — the subject ----
ENGRAM_TARGET_DSN=postgresql://<user>:<pw>@<host>:26257/defaultdb?sslmode=verify-full
ENGRAM_TARGET_CLUSTER_ID=<uuid from the cluster page URL>

# ---- Managed MCP server (P0-B2) — scope mcp:read, Cluster Operator ----
# CRDB_MCP_CLUSTER_ID must be the MEMORY cluster UUID (same as ENGRAM_MEMORY_CLUSTER_ID).
CRDB_MCP_URL=https://cockroachlabs.cloud/mcp
CRDB_MCP_TOKEN=
CRDB_MCP_CLUSTER_ID=
CRDB_MCP_DATABASE=defaultdb
CRDB_MCP_PROBE_TABLE=vec_probe

# ---- Reasoning provider (CLAUDE.md §2.1, D13) ----
# Ladder: ollama -> groq -> together. A rung change is a config change, not a
# code change (LLMProvider ABC). No rung touches Bedrock.
ENGRAM_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
ENGRAM_LLM_MODEL=minimax-m3:cloud  # UNVERIFIED tag — probe before the Day-4 tool-schema freeze
ENGRAM_LLM_TIMEOUT_S=90
ENGRAM_LLM_MAX_RETRIES=3

# ---- Ladder rungs 2 and 3 — fill only when a rung is in use ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1

# ---- Embeddings — Cohere embed-english-v3.0, natively 1024-dim ----
# 1024 is a SCHEMA INVARIANT (VECTOR(1024) + C-SPANN vector_cosine_ops), not a
# tuning knob: no truncation, padding or projection. Changing the MODEL changes
# the vector space and requires a full re-embed — there is no fallback ladder.
# input_type is required per call: search_document on write, search_query on
# recall. Collapsing that degrades recall silently rather than erroring.
ENGRAM_EMBED_PROVIDER=cohere
ENGRAM_EMBED_MODEL=embed-english-v3.0
ENGRAM_EMBED_DIMS=1024

# ---- S3 artifacts (invariant #11) ----
# Rows hold the s3:// URI + content hash, never the blob. IAM: s3:PutObject /
# s3:GetObject scoped to this bucket ARN only — never s3:*, never Resource "*".
ENGRAM_S3_BUCKET=engram-agent-artifacts
